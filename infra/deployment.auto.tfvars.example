# Copy to deployment.auto.tfvars before the first full plan. This file is
# intentionally ignored so an operator, not a source-code merge, controls when
# externally reachable apps may exist.
deployment_environment  = "prod"
azure_deid_service_id   = "/subscriptions/bab2a709-1fcb-4c87-a9fc-802f7477ec13/resourceGroups/cosmaneura-prod/providers/Microsoft.HealthDataAIServices/deidServices/AnonymizerAPI"
# Preserve the existing production OIDC deploy path; its repository kill switch
# remains independently default-off.
github_deploy_enabled   = true
live_apps_enabled       = false
# Provider-only creation is separately reviewed; leave the legacy dual gate off.
production_provider_app_enabled = false
# This provider-only assertion never stands in for both-vault readiness.
production_provider_key_vault_secrets_ready = false
key_vault_secrets_ready = false
initial_image_ref        = ""

# For one reviewed paired activation, set both booleans to true and persist the
# exact registry/repository@sha256:... fallback digest. Refresh that digest to
# the current paired deployment before every later infrastructure plan.
# For a provider-only production creation, enable only
# production_provider_app_enabled and
# production_provider_key_vault_secrets_ready with that reviewed immutable
# digest. Keep key_vault_secrets_ready=false because the public vault/app remain
# out of scope. Public foundations retain their existing addresses; these
# controls do not authorize or redesign their bootstrap/provisioning.
