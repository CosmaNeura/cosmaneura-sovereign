# Copy to deployment.auto.tfvars only for the isolated non-production
# rehearsal stack. There are deliberately no production resource defaults.
deployment_environment  = "staging"
# Staging creates its own `cosmaneura-staging-deid` resource. A production or
# shared DeID resource ID is intentionally not an accepted staging input.

# The current staging rollout is operator-driven. Do not create a latent
# federated deploy principal or its roles.
github_deploy_enabled   = false
live_apps_enabled       = false
key_vault_secrets_ready = false
initial_image_ref        = ""

# For one reviewed paired activation, set both booleans to true and persist an
# immutable digest from cosmaneurasovereignstagingregistry.azurecr.io only.
