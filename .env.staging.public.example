# Non-production anonymous public mount for the paired live-smoke and rollback
# rehearsal only. Copy to `.env.staging.public`. Authority settings remain
# literal Terraform invariants and cannot be supplied here.

MOCK_MODE=false
SOVEREIGN_MODE=hybrid

LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://cosmascode.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_VERSION=2025-03-01-preview
REASONING_MODEL=gpt-5.6-sol
FAST_MODEL=gpt-5.4-nano

MAGISTERIUM_BASE_URL=https://www.magisterium.com/api/v1
MAGISTERIUM_MODEL=magisterium-1
MAGISTERIUM_MCP_ENABLED=false
ANTHROPIC_MCP_BETA=mcp-client-2025-11-20

NPPES_BASE_URL=https://npiregistry.cms.hhs.gov/api
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2

AUDIT_SINK=file
AUDIT_PATH=/tmp/public_audit_log.jsonl
CORS_ALLOW_ORIGINS=["https://staging.cosmaneura.com"]
PUBLIC_CHAT_RATE_LIMIT_REQUESTS=30
PUBLIC_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_CHAT_RATE_LIMIT_MAX_CLIENTS=10000

# These public-mount items must be separate from both Production and the
# staging provider mount. No Athena or record-grant reference belongs here.
export MAGISTERIUM_API_KEY='op://Staging/magisterium-public/credential'
export AZURE_OPENAI_API_KEY='op://Staging/CosmasCode-public/credential'
