# Production env for the Sovereign container app.
#
# Copy to `.env.production.backend` and fill in. Secret values remain 1Password
# references (op://VAULT/ITEM/field) until the one-time, file-based Key Vault
# sync. Terraform reads only the non-secret literal app configuration.
# Every provider key referenced in infra/variables.tf MUST be present. The
# anonymous public mount has its own .env.production.public.example; never
# reuse this provider export for it.

# ---- Runtime ----
MOCK_MODE=false
SOVEREIGN_MODE=hybrid
MOUNT_PROFILE=provider_assistant
# Opaque practice scope; never a display name or a request-derived value.
MOUNT_TENANT_ID=tenant_replace_me

# ---- Auth: Core-owned actor and opaque mount authority ----
# disabled means Sovereign does not parse a browser JWT. Core verifies the
# actor before issuing the sole inbound bearer: a short-lived opaque mount token.
AUTH_MODE=disabled
# Retained legacy metadata is not an authority source in the platform profile.
OIDC_ISSUER=https://your-instance.clerk.accounts.dev
OIDC_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
OIDC_AUDIENCE=cosmaneura-sovereign
OIDC_ALGORITHMS=["RS256"]
AUTH_ROLE_CLAIM=roles
AUTH_PROVIDER_ROLE=provider

# ---- Platform authority (production activation remains separately gated) ----
PLATFORM_AGENT_API_ENABLED=true
PLATFORM_AGENT_API_BASE_URL=https://app.cosmaneura.com
PLATFORM_AGENT_API_SCOPE=api://af957741-0342-498b-8496-e93706af9e99/.default
# Provider workload identity is injected from Terraform; Core's client-ID
# allowlist and AgentApi.Access assignment must match it before activation.
# Keep the feature dark while infrastructure/images/Core gates are prepared.
# A separately reviewed activation changes only this pair to true/platform.
FEATURE_SESSION_PREP=false
SESSION_PREP_CONTEXT_SOURCE=synthetic

# ---- Compliance gates (provider build) ----
# Legacy compatibility only; mount authority no longer comes from persona.
ALLOW_PROVIDER_PERSONA=false
# Set true only after the applicable Azure BAA controls are verified.
BAA_ATTESTED=true

# ---- PHI de-identification ----
# "azure" = HIPAA-grade Azure Health Data Services (catches names/locations);
# required for the provider/PHI build. "regex" = baseline (patient build only).
# Auth is keyless via the container app's managed identity (see infra/deid.tf) —
# no AZURE_DEID_CLIENT_SECRET needed.
DEID_PROVIDER=azure
# Terraform reads and injects AZURE_DEID_ENDPOINT from the existing production
# DeID data resource; this file must not duplicate the service URL.

# ---- Reasoning LLM (must be BAA-covered for the provider build) ----
# Azure OpenAI — the path CosmaNeura already uses (BAA-covered under the Azure
# BAA; reuses the existing prod resource + credits). REASONING_MODEL/FAST_MODEL
# are Azure *deployment* names. For Anthropic instead: LLM_PROVIDER=anthropic
# with ANTHROPIC_API_KEY + claude-* model IDs.
LLM_PROVIDER=azure_openai
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# CosmasCode Foundry resource (v1 endpoint dialect). Not a secret.
AZURE_OPENAI_ENDPOINT=https://cosmascode.services.ai.azure.com/openai/v1
# Azure *deployment names* exactly as created in Foundry (July 2026).
# Upgrading a model later = new deployment + a one-line change here.
REASONING_MODEL=gpt-5.6-sol
FAST_MODEL=gpt-5.4-nano

# ---- Doctrinal authority ----
MAGISTERIUM_BASE_URL=https://www.magisterium.com/api/v1
MAGISTERIUM_MODEL=magisterium-1
MAGISTERIUM_MCP_ENABLED=false
ANTHROPIC_MCP_BETA=mcp-client-2025-11-20

# ---- Public data sources (free, no key) ----
NPPES_BASE_URL=https://npiregistry.cms.hhs.gov/api
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2

# ---- Audit + web ----
AUDIT_SINK=stdout
AUDIT_PATH=/tmp/audit_log.jsonl
CORS_ALLOW_ORIGINS=["https://app.cosmaneura.com"]

# ---- Hidden tools remain disabled for the operational provider beta ----
# The platform capability ceiling also excludes referrals, labs, plan workbench
# and journey digest from both welcome and execution.
FEATURE_ATHENA_LABS=false
ATHENA_ENV=preview
ATHENA_PRACTICE_ID=195900
ATHENA_DEPARTMENT_ID=1
LABS_ALLOW_PATIENT_SEARCH=false

# ---- Secret sources for the one-time Key Vault sync ----
# Terraform stores only versionless Key Vault URIs. Run
# infra/scripts/sync-key-vault-secrets.sh provider <provider-vault-name> after
# the vault/identity bootstrap; these values never enter Terraform state.
export MAGISTERIUM_API_KEY='op://Production/magisterium-api/credential'
# Key for the CosmasCode Foundry resource (portal.azure.com -> CosmasCode ->
# Keys and Endpoint). Rotate at consolidation, then on any exposure — if a key
# is EVER pasted outside 1Password, regenerate it immediately; rotation is instant.
export AZURE_OPENAI_API_KEY='op://Production/CosmasCode/credential'
# Canonical Fernet key shared only with the platform provider host. Generate it
# exactly with cryptography.fernet.Fernet.generate_key() (44-character urlsafe
# base64 for 32 random bytes); it authenticates the platform-derived 60-second
# open-record grant. Keep the value out of env exports, Terraform state, logs,
# and command arguments.
export SOVEREIGN_RECORD_GRANT_SECRET='op://Production/sovereign-record-grant/credential'
