# Non-production provider mount for the paired live-smoke and rollback
# rehearsal only. Copy to `.env.staging.backend`. Secret values stay as
# Staging-vault 1Password references until the file-based Key Vault sync.

# ---- Runtime ----
MOCK_MODE=false
SOVEREIGN_MODE=hybrid
MOUNT_PROFILE=provider_assistant
MOUNT_TENANT_ID=tenant_staging_preview_195900

# ---- Clerk/OIDC provider authority ----
AUTH_MODE=oidc
# Accepted non-secret staging contract. Production uses its own Clerk instance.
OIDC_ISSUER=https://resolved-emu-53.clerk.accounts.dev
OIDC_JWKS_URL=https://resolved-emu-53.clerk.accounts.dev/.well-known/jwks.json
OIDC_AUDIENCE=cosmaneura-sovereign
OIDC_ALGORITHMS=["RS256"]
AUTH_ROLE_CLAIM=roles
AUTH_PROVIDER_ROLE=provider

# ---- Compliance gates ----
ALLOW_PROVIDER_PERSONA=false
# This remains a real legal/operational assertion even in staging. Do not set
# true until the applicable Azure BAA controls have been verified.
BAA_ATTESTED=true

# ---- PHI boundary ----
DEID_PROVIDER=azure
# Terraform derives AZURE_DEID_ENDPOINT from the staging-owned DeID resource.

# ---- BAA-covered reasoning LLM ----
LLM_PROVIDER=azure_openai
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_ENDPOINT=https://cosmascode.services.ai.azure.com/openai/v1
REASONING_MODEL=gpt-5.6-sol
FAST_MODEL=gpt-5.4-nano

# ---- Doctrinal authority ----
MAGISTERIUM_BASE_URL=https://www.magisterium.com/api/v1
MAGISTERIUM_MODEL=magisterium-1
MAGISTERIUM_MCP_ENABLED=false
ANTHROPIC_MCP_BETA=mcp-client-2025-11-20

# ---- Public data sources ----
NPPES_BASE_URL=https://npiregistry.cms.hhs.gov/api
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2

# ---- Audit + web ----
AUDIT_SINK=file
AUDIT_PATH=/tmp/audit_log.jsonl
CORS_ALLOW_ORIGINS=["https://staging-app.cosmaneura.com"]

# ---- Synthetic athenahealth Preview labs only ----
FEATURE_ATHENA_LABS=true
ATHENA_ENV=preview
ATHENA_PRACTICE_ID=195900
ATHENA_DEPARTMENT_ID=1
LABS_ALLOW_PATIENT_SEARCH=false

# ---- Staging-only secret sources ----
# These items and the record-grant key must be distinct from Production.
export MAGISTERIUM_API_KEY='op://Staging/magisterium-api/credential'
export AZURE_OPENAI_API_KEY='op://Staging/CosmasCode/credential'
export ATHENA_CLIENT_ID='op://Staging/athenahealth-preview/client-id'
export ATHENA_CLIENT_SECRET='op://Staging/athenahealth-preview/client-secret'
export SOVEREIGN_RECORD_GRANT_SECRET='op://Staging/sovereign-record-grant/credential'
