# ---- Runtime ----
# Keep true to run with zero credentials. Set false in real environments.
MOCK_MODE=true
AUDIT_SINK=stdout            # stdout | file
AUDIT_PATH=./audit_log.jsonl

# Exactly one fixed authority profile per process. The public profile below
# derives its surface, anonymous tier, and capability set server-side.
MOUNT_PROFILE=public
PUBLIC_CHAT_RATE_LIMIT_REQUESTS=30
PUBLIC_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_CHAT_RATE_LIMIT_MAX_CLIENTS=10000
PUBLIC_CHAT_TRUST_FORWARDED_FOR=false

# ---- Security gates ----
# Legacy compatibility setting only; it grants no authority. Named deployment
# profiles and verified actor identity now control the provider path. Keep false.
ALLOW_PROVIDER_PERSONA=false
# Legal attestation that the LLM inference path is covered by an EXECUTED BAA
# with Zero Data Retention (or hyperscaler-BAA equivalent). The provider/PHI
# path refuses to run in non-mock mode without this. Set true only after the
# agreement is actually signed.
BAA_ATTESTED=false

# ---- Authentication ----
# disabled | dev_hs256 | oidc. Provider/PHI deployments MUST use oidc so persona
# is bound to a verified identity. "disabled" is patient-only / local dev.
AUTH_MODE=disabled
# OIDC (production): values come from your identity provider.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=["RS256"]
# Claim that carries roles (dotted paths allowed, e.g. realm_access.roles for
# Keycloak, or a namespaced claim like https://cosmaneura.com/roles for Auth0),
# and the role value that grants the provider (PHI) persona.
AUTH_ROLE_CLAIM=roles
AUTH_PROVIDER_ROLE=provider
# Dev-only shared secret for AUTH_MODE=dev_hs256. Leave empty in production.
AUTH_DEV_SECRET=
# Browser CORS allowlist (comma/JSON list). Empty = no cross-origin access.
# Never set to "*". Example: ["https://app.example.com"]
CORS_ALLOW_ORIGINS=[]

# ---- Magisterium (doctrinal authority + final arbiter) ----
# Get a key at https://www.magisterium.com/developers/api
MAGISTERIUM_API_KEY=
MAGISTERIUM_BASE_URL=https://www.magisterium.com/api/v1
MAGISTERIUM_MODEL=magisterium-1
MAGISTERIUM_MCP_URL=https://mcp.magisterium.com
# Optional ADDITIVE inline doctrinal layer via Anthropic's MCP connector.
# OFF by default. Requires a magisterium.com account + a pre-acquired OAuth token.
# COMPLIANCE: the MCP connector is NOT ZDR-eligible and NOT available on
# Bedrock/Vertex, and Magisterium is not a BAA -- so this layer only ever sees
# DE-IDENTIFIED text (enforced in code). Never used on the provider/PHI path.
MAGISTERIUM_MCP_ENABLED=false
MAGISTERIUM_MCP_TOKEN=
# Confirm current value: https://platform.claude.com/docs/en/agents-and-tools/mcp-connector
ANTHROPIC_MCP_BETA=mcp-client-2025-11-20

# ---- Sovereign composition ----
# hybrid  (recommended): LLM routes the task, Magisterium is the final judge.
# literal : Magisterium is consulted on every request (slower). See ARCHITECTURE.md.
SOVEREIGN_MODE=hybrid

# ---- Reasoning LLM (Sovereign brain + agents) ----
# For the PROVIDER/HIPAA build this MUST be a BAA-covered path:
# Azure OpenAI under the Microsoft BAA/DPA (current production plan), OR
# Anthropic 1P API with Zero Data Retention + signed BAA.
#
# Azure path (production plan): REASONING_MODEL / FAST_MODEL are the Azure
# *deployment names* from Foundry's "Models + endpoints" list — role-based on
# purpose, so upgrading the underlying model never touches this config.
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://cosmascode.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
REASONING_MODEL=gpt-5.6-sol
FAST_MODEL=gpt-5.4-mini
# Anthropic path (alternative): set LLM_PROVIDER=anthropic and use claude-*
# model IDs for REASONING_MODEL / FAST_MODEL.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# ---- Public data sources (free, no key) ----
NPPES_BASE_URL=https://npiregistry.cms.hhs.gov/api
CLINICALTRIALS_BASE_URL=https://clinicaltrials.gov/api/v2
# PubMed/PMC (NCBI E-utilities). Key optional; only raises rate limits.
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
PUBMED_API_KEY=

# ---- Partner directory (MyCatholicDoctor + resource partners) ----
# Leave blank to use the bundled JSON fixture.
PARTNER_DIRECTORY_URL=
PARTNER_DIRECTORY_API_KEY=

# ---- EMR lab results (athenahealth) — sandbox demo feature ----
# Whole capability off by default; see ATHENA_LABS.md. Credentials come from
# the athenahealth Developer Console app (store in Key Vault/1Password).
FEATURE_ATHENA_LABS=false
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=
ATHENA_ENV=preview
ATHENA_PRACTICE_ID=195900
ATHENA_DEPARTMENT_ID=1
# Name-based patient search bypasses host authorization — sandbox only.
LABS_ALLOW_PATIENT_SEARCH=false
